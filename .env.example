# Used when running the app on the host (npm run start:dev) against docker-compose infra.
NODE_ENV=development
PORT=3410
METRICS_PORT=3411
LOG_LEVEL=debug
DATABASE_URL=postgres://capacity:capacity@localhost:3413/capacity
KAFKA_ENABLED=true
KAFKA_BROKERS=localhost:3414
KAFKA_GROUP_ID=program-capacity-service-local
AUTH_ISSUER=http://dev-idp.local
AUTH_AUDIENCE=program-capacity-api
AUTH_JWKS_URL=http://localhost:3412/.well-known/jwks.json
FX_STATIC_RATES=EUR:USD=1.08,GBP:USD=1.27,USD:JPY=149.50,CHF:USD=1.13,KWD:USD=3.25
FX_MAX_RATE_AGE_SEC=3600
RECON_MAX_AUTO_DRIFT_RATIO=0
RATE_LIMIT_PER_MINUTE=600
